@model SupplySearchViewModel
@{ ViewData["Title"] = "Tìm kiếm vật tư"; }

<div class="page-header">
    <h2 class="page-title">Tìm kiếm Vật tư</h2>
    <a class="btn btn-light" asp-controller="Supplies" asp-action="Index">Quay lại danh sách</a>
</div>

<div class="form-layout">
    <form class="form-box" asp-controller="Supplies" asp-action="Search" method="get">
        <div class="form-group">
            <label asp-for="Keyword">Từ khóa (Tên, Mã, Nhóm)</label>
            <input asp-for="Keyword" class="form-control" placeholder="VD: Khẩu trang..." />
        </div>
        <div class="form-group">
            <label asp-for="StockStatus">Tình trạng tồn kho</label>
            <select asp-for="StockStatus" class="form-control">
                <option value="">-- Tất cả --</option>
                <option value="instock">Còn hàng</option>
                <option value="lowstock">Cần nhập thêm</option>
                <option value="outofstock">Hết hàng</option>
            </select>
        </div>
        <button class="btn" type="submit">Tìm kiếm</button>
        <a class="btn btn-secondary" asp-controller="Supplies" asp-action="Search">Đặt lại</a>
    </form>

    <div>
        <h3>Kết quả tìm kiếm</h3>
        <p>Từ khóa: <strong>@Model.Keyword</strong> | Tình trạng: <strong>@(string.IsNullOrEmpty(Model.StockStatus) ? "Tất cả" : Model.StockStatus)</strong></p>

        @if (Model.Supplies.Count == 0)
        {
            <div class="info-box" style="background-color: #fff3cd; color: #856404; border-color: #ffeeba;">
                Không tìm thấy vật tư phù hợp. Vui lòng thử từ khóa khác.
            </div>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Mã VT</th>
                        <th>Tên vật tư</th>
                        <th>Nhóm</th>
                        <th>Đơn giá</th>
                        <th>Số lượng</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Supplies)
                    {
                        <tr>
                            <td>@item.Code</td>
                            <td>@item.Name</td>
                            <td>@item.Category</td>
                            <td>@item.PriceText</td>
                            <td>@item.Quantity</td>
                            <td>
                                <a asp-controller="Supplies" asp-action="Detail" asp-route-id="@item.Id">Xem</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
