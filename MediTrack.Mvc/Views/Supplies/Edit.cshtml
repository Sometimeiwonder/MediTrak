@model SupplyEditViewModel
@{ ViewData["Title"] = "Sửa vật tư"; }

<div class="page-header">
    <h2 class="page-title">Sửa vật tư</h2>
    <a class="btn btn-light" asp-controller="Supplies" asp-action="Index">Quay lại danh sách</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="success-box">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="form-layout">
    <div>
        <form class="form-box" asp-controller="Supplies" asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ConcurrencyVersion" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Code">Mã vật tư</label>
                <input asp-for="Code" class="form-control" placeholder="VD: MS-KHA-006" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Name">Tên vật tư</label>
                <input asp-for="Name" class="form-control" placeholder="VD: Khẩu trang N95" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SupplyCategoryId">Nhóm vật tư</label>
                <select asp-for="SupplyCategoryId" class="form-control"
                        asp-items="@(new SelectList(Model.Categories, "Id", "Name"))">
                    <option value="">-- Chọn nhóm --</option>
                </select>
                <span asp-validation-for="SupplyCategoryId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Supplier">Nhà cung cấp</label>
                <input asp-for="Supplier" class="form-control" placeholder="VD: VinMed" />
                <span asp-validation-for="Supplier" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Price">Đơn giá</label>
                <input asp-for="Price" type="number" class="form-control" placeholder="VD: 50000" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Quantity">Số lượng tồn</label>
                <input asp-for="Quantity" type="number" class="form-control" placeholder="VD: 100" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MinStock">Mức tối thiểu</label>
                <input asp-for="MinStock" type="number" class="form-control" placeholder="VD: 20" />
                <span asp-validation-for="MinStock" class="text-danger"></span>
            </div>

            <button class="btn" type="submit">Lưu thay đổi</button>
        </form>

        <div class="form-box" style="margin-top: 1rem;">
            <h3>Thay ảnh vật tư</h3>
            <form asp-controller="Supplies" asp-action="UploadImage" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="form-group">
                    <label>Chọn ảnh mới (JPG, PNG, WebP, tối đa 2MB)</label>
                    <input type="file" name="imageFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                </div>
                <button type="submit" class="btn btn-secondary">Tải ảnh lên</button>
            </form>
        </div>
    </div>

    <div>
        <div class="form-box">
            <h3>Ảnh hiện tại</h3>
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="Ảnh vật tư" style="max-width: 100%; border-radius: 12px; border: 1px solid #e2e8f0;" />
            }
            else
            {
                <p>Chưa có ảnh.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
