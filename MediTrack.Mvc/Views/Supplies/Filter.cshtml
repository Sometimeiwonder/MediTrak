@model SupplyFilterViewModel
@{ ViewData["Title"] = "Lọc vật tư"; }

<div class="page-header">
    <div>
        <h2 class="page-title">Lọc vật tư theo danh mục và giá</h2>
        <p class="page-description">Trang lọc sử dụng Relationship và AsNoTracking.</p>
    </div>
    <a class="btn btn-light" asp-controller="Supplies" asp-action="Index">Quay lại danh sách</a>
</div>

<form class="form-box" asp-controller="Supplies" asp-action="Filter" method="get" style="margin-bottom:1rem;">
    <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div class="form-group">
            <label>Danh mục</label>
            <select name="categoryId" class="form-control">
                <option value="">-- Tất cả --</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label>Giá tối thiểu</label>
            <input name="minPrice" type="number" class="form-control" value="@Model.MinPrice" />
        </div>
        <div class="form-group">
            <label>Giá tối đa</label>
            <input name="maxPrice" type="number" class="form-control" value="@Model.MaxPrice" />
        </div>
        <div class="form-group" style="align-self:flex-end;">
            <button class="btn" type="submit">Lọc</button>
        </div>
    </div>
</form>

@if (Model.Results.Count == 0)
{
    <div class="info-box">Không tìm thấy vật tư phù hợp.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Mã VT</th>
                <th>Tên vật tư</th>
                <th>Danh mục</th>
                <th>Nhà cung cấp</th>
                <th>Đơn giá</th>
                <th>Tồn kho</th>
                <th>Chi tiết</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Results)
            {
                <tr>
                    <td>@item.Code</td>
                    <td>@item.Name</td>
                    <td>@item.Category</td>
                    <td>@item.Supplier</td>
                    <td>@item.PriceText</td>
                    <td>@item.Quantity</td>
                    <td>
                        <a asp-controller="Supplies" asp-action="Detail" asp-route-id="@item.Id">Xem</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
