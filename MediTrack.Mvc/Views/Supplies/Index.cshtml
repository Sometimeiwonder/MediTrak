@model List<SupplyListItemViewModel>

@{
    ViewData["Title"] = "Danh sách Vật tư";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Danh sách Vật tư Y tế</h2>
        <p class="page-description">Danh sách vật tư y tế hiện có trong kho.</p>
    </div>
    <div>
        <a class="btn btn-secondary" asp-controller="Supplies" asp-action="Search">Tìm kiếm</a>
        <a class="btn" asp-controller="Supplies" asp-action="Create">Thêm vật tư</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="success-box">@TempData["SuccessMessage"]</div>
}

<div class="info-box"><strong>Tổng số vật tư:</strong> @Model.Count</div>

@if (Model.Count == 0)
{
    <p>Chưa có vật tư nào trong kho.</p>
}
else
{
    <div class="product-grid">
        @foreach (var item in Model)
        {
            <partial name="_SupplyCard" model="item" />
        }
    </div>
}
