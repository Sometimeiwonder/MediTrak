@model SupplyAdjustStockViewModel
@{ ViewData["Title"] = "Điều chỉnh tồn kho"; }

<div class="page-header">
    <h2 class="page-title">Điều chỉnh số lượng tồn kho</h2>
    <a class="btn btn-light" asp-controller="Supplies" asp-action="Detail" asp-route-id="@Model.Id">Quay lại chi tiết</a>
</div>

<div class="detail-layout">
    <div>
        <table class="table table-bordered">
            <tr><th>Mã vật tư</th><td>@Model.Code</td></tr>
            <tr><th>Tên vật tư</th><td>@Model.Name</td></tr>
            <tr><th>Số lượng hiện tại</th><td>@Model.CurrentQuantityText</td></tr>
        </table>
    </div>
</div>

<div class="form-layout" style="margin-top: 1rem;">
    <form class="form-box" asp-controller="Supplies" asp-action="AdjustStock" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ConcurrencyVersion" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Adjustment">Số lượng thay đổi (nhập âm để giảm, dương để tăng)</label>
            <input asp-for="Adjustment" type="number" class="form-control" placeholder="VD: 50 hoặc -20" />
            <span asp-validation-for="Adjustment" class="text-danger"></span>
        </div>

        <div class="info-box">
            <strong>Số lượng sau điều chỉnh:</strong> <span id="newQuantity">@Model.NewQuantityText</span>
        </div>

        <button class="btn" type="submit" id="btnAdjust">Điều chỉnh</button>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        document.getElementById('Adjustment').addEventListener('input', function() {
            var current = @Model.CurrentQuantity;
            var adjustment = parseInt(this.value) || 0;
            var newQty = current + adjustment;
            document.getElementById('newQuantity').textContent = newQty.toLocaleString();
            var btn = document.getElementById('btnAdjust');
            if (newQty < 0) {
                btn.disabled = true;
                btn.textContent = 'Không thể điều chỉnh (tồn kho âm)';
            } else {
                btn.disabled = false;
                btn.textContent = 'Điều chỉnh';
            }
        });
    </script>
}
