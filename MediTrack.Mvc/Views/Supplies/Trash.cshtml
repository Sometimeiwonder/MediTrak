@model List<SupplyTrashItemViewModel>
@{ ViewData["Title"] = "Thùng rác - Vật tư đã xóa"; }

<div class="page-header">
    <div>
        <h2 class="page-title">Thùng rác - Vật tư đã xóa</h2>
        <p class="page-description">Danh sách vật tư đã bị xóa mềm. Bạn có thể khôi phục nếu cần.</p>
    </div>
    <a class="btn btn-light" asp-controller="Supplies" asp-action="Index">Quay lại danh sách</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="success-box">@TempData["SuccessMessage"]</div>
}

<div class="info-box"><strong>Tổng số vật tư đã xóa:</strong> @Model.Count</div>

@if (Model.Count == 0)
{
    <p>Không có vật tư nào trong thùng rác.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Mã VT</th>
                <th>Tên vật tư</th>
                <th>Nhóm</th>
                <th>Ngày xóa</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Code</td>
                    <td>@item.Name</td>
                    <td>@item.Category</td>
                    <td>@item.DeletedAtText</td>
                    <td>
                        <form asp-controller="Supplies" asp-action="Restore" asp-route-id="@item.Id" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success btn-sm">Khôi phục</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
