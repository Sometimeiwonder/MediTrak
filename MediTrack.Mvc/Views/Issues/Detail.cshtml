@model Issue
@{ ViewData["Title"] = "Chi tiết phiếu xuất"; }

<div class="page-header">
    <div>
        <h2 class="page-title">Chi tiết phiếu xuất #@Model.Id</h2>
        <p class="page-description">Thông tin chi tiết phiếu xuất vật tư.</p>
    </div>
    <a class="btn btn-light" asp-controller="Issues" asp-action="Index">Quay lại danh sách</a>
</div>

<table class="table table-bordered">
    <tr><th>Mã phiếu</th><td>@Model.Id</td></tr>
    <tr><th>Người nhận</th><td>@Model.IssuedTo</td></tr>
    <tr><th>Ngày xuất</th><td>@Model.IssuedAt.ToString("dd/MM/yyyy HH:mm")</td></tr>
    <tr><th>Tổng giá trị</th><td>@Model.TotalAmount.ToString("N0") đ</td></tr>
</table>

<h3 class="mt-4">Chi tiết phiếu xuất</h3>
<table class="table">
    <thead>
        <tr>
            <th>Vật tư</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Thành tiền</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.IssueItems)
        {
            <tr>
                <td>@item.MedicalSupply?.Name</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("N0") đ</td>
                <td>@((item.UnitPrice * item.Quantity).ToString("N0")) đ</td>
            </tr>
        }
    </tbody>
</table>
