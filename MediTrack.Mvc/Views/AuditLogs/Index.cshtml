@model List<MediTrack.Mvc.Models.AuditLog>

@{
    ViewData["Title"] = "Nhật ký kiểm toán";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Nhật ký kiểm toán (Audit Logs)</h2>
        <p class="page-description">Xem các hành động đã được ghi nhận trong hệ thống.</p>
    </div>
</div>

<div class="filter-form">
    <form method="get" asp-controller="AuditLogs" asp-action="Index">
        <div class="filter-row">
            <div class="form-group">
                <label for="userName">Người dùng</label>
                <input type="text" id="userName" name="userName" value="@ViewBag.UserName" class="form-control" placeholder="Nhập tên người dùng..." />
            </div>
            <div class="form-group">
                <label for="logAction">Hành động</label>
                <select id="logAction" name="logAction" class="form-control">
                    <option value="">Tất cả</option>
                    <option value="Login" selected="@(ViewBag.LogAction == "Login")">Login</option>
                    <option value="Logout" selected="@(ViewBag.LogAction == "Logout")">Logout</option>
                    <option value="Register" selected="@(ViewBag.LogAction == "Register")">Register</option>
                    <option value="Create" selected="@(ViewBag.LogAction == "Create")">Create</option>
                    <option value="Edit" selected="@(ViewBag.LogAction == "Edit")">Edit</option>
                    <option value="Delete" selected="@(ViewBag.LogAction == "Delete")">Delete</option>
                    <option value="Restore" selected="@(ViewBag.LogAction == "Restore")">Restore</option>
                    <option value="ReplaceProductImage" selected="@(ViewBag.LogAction == "ReplaceProductImage")">Replace Image</option>
                    <option value="AdjustStock" selected="@(ViewBag.LogAction == "AdjustStock")">Adjust Stock</option>
                    <option value="AccessDenied" selected="@(ViewBag.LogAction == "AccessDenied")">Access Denied</option>
                </select>
            </div>
            <div class="form-group">
                <label for="result">Kết quả</label>
                <select id="result" name="result" class="form-control">
                    <option value="">Tất cả</option>
                    <option value="Success" selected="@(ViewBag.Result == "Success")">Success</option>
                    <option value="Failed" selected="@(ViewBag.Result == "Failed")">Failed</option>
                    <option value="Rejected" selected="@(ViewBag.Result == "Rejected")">Rejected</option>
                </select>
            </div>
            <div class="form-group">
                <label for="fromDate">Từ ngày</label>
                <input type="date" id="fromDate" name="fromDate" value="@ViewBag.FromDate" class="form-control" />
            </div>
            <div class="form-group">
                <label for="toDate">Đến ngày</label>
                <input type="date" id="toDate" name="toDate" value="@ViewBag.ToDate" class="form-control" />
            </div>
            <div class="form-group filter-actions">
                <button type="submit" class="btn btn-primary">Lọc</button>
                <a asp-controller="AuditLogs" asp-action="Index" class="btn btn-secondary">Xóa lọc</a>
            </div>
        </div>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="info-box">Không có nhật ký nào phù hợp với điều kiện tìm kiếm.</div>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Thời gian</th>
                    <th>Người dùng</th>
                    <th>Hành động</th>
                    <th>Entity</th>
                    <th>Entity ID</th>
                    <th>Kết quả</th>
                    <th>IP Address</th>
                    <th>Ghi chú</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr class="@(log.Result == "Failed" || log.Result == "Rejected" ? "row-warning" : "")">
                        <td>@log.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td>@log.UserName</td>
                        <td><span class="badge badge-@(log.Action.ToLower())">@log.Action</span></td>
                        <td>@log.EntityName</td>
                        <td>@log.EntityId</td>
                        <td><span class="badge badge-@log.Result.ToLower()">@log.Result</span></td>
                        <td>@log.IpAddress</td>
                        <td>@log.Note</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="pagination-info">
        Hiển thị @Model.Count nhật ký
    </div>
}
