@model SupplyListItemViewModel

<div class="product-card">
    <h3>@Model.Name</h3>
    <p class="product-meta">Mã VT: @Model.Code</p>
    <p class="product-meta">Nhóm: @Model.Category</p>
    <p class="product-price">@Model.PriceText</p>
    <p>Số lượng tồn: <strong>@Model.Quantity</strong></p>

    @if (Model.StockStatus == "Còn hàng")
    {
        <span class="badge badge-success">@Model.StockStatus</span>
    }
    else if (Model.StockStatus == "Cần nhập thêm")
    {
        <span class="badge badge-warning">@Model.StockStatus</span>
    }
    else
    {
        <span class="badge badge-danger">@Model.StockStatus</span>
    }

    <div class="card-actions">
        <a class="btn btn-light" asp-controller="Supplies" asp-action="Detail" asp-route-id="@Model.Id">
            Xem chi tiết
        </a>
        @if (User.IsInRole("Admin"))
        {
            <a class="btn btn-secondary" asp-controller="Supplies" asp-action="Edit" asp-route-id="@Model.Id">
                Sửa
            </a>
            <a class="btn btn-danger" asp-controller="Supplies" asp-action="Delete" asp-route-id="@Model.Id">
                Xóa
            </a>
        }
    </div>
</div>
