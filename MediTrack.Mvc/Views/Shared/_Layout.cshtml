<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediTrack</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container header-content">
            <div class="brand">
                <a asp-controller="Home" asp-action="Index">MediTrack</a>
            </div>
            <nav class="main-nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Home" asp-action="Index">Tổng quan</a>
                    <a asp-controller="Supplies" asp-action="Index">Vật tư</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Supplies" asp-action="Create">Thêm mới</a>
                    }
                    <a asp-controller="Supplies" asp-action="Trash">Thùng rác</a>
                    <a asp-controller="Supplies" asp-action="Search">Tìm kiếm</a>
                    <a asp-controller="SupplyCategories" asp-action="Index">Danh mục</a>
                    @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                    {
                        <a asp-controller="Issues" asp-action="Index">Phiếu xuất</a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="AuditLogs" asp-action="Index">Nhật ký</a>
                    }
                    <a href="/health/ready">Sức khỏe</a>
                }
            </nav>
            <div class="user-menu">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="user-info">
                        Xin chào, <strong>@User.Identity.Name</strong>
                        @if (User.IsInRole("Admin"))
                        {
                            <span class="badge badge-admin">Admin</span>
                        }
                        else if (User.IsInRole("Staff"))
                        {
                            <span class="badge badge-staff">Staff</span>
                        }
                        else
                        {
                            <span class="badge badge-user">User</span>
                        }
                    </span>
                    <form asp-controller="Account" asp-action="Logout" method="post" style="display: inline;">
                        <button type="submit" class="btn btn-logout">Đăng xuất</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-login">Đăng nhập</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-register">Đăng ký</a>
                }
            </div>
        </div>
    </header>

    <main class="container main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-content">
            <span>&copy; 2026 - Hệ thống Quản lý Vật tư Y tế</span>
            <a href="#">Quyền riêng tư</a>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
