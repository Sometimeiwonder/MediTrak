{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=MediTrack.db"
  },
  "AppSettings": {
    "AppName": "Medical Supplies Lab05",
    "SupportEmail": "support@medical.vn",
    "EnableSeedData": true,
    "LowStockThreshold": 200
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
